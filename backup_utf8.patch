+                    ps = koneksi.prepareStatement("INSERT INTO pku_list_klaim (no_rawat, catatan, status_tidak_klaim, tgl_input, jam_input, user_input) VALUES (?, ?, '1', CURDATE(), CURTIME(), ?)");
